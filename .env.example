# Copy to .env and adjust. Every value here is optional.

# --- SteamCMD -----------------------------------------------------------------
# Use a Steam account that owns Arma 2 / Operation Arrowhead. The apps below are
# NOT downloadable anonymously (SteamCMD answers "No subscription"), including
# the dedicated-server tool 33935/33905, which ships with the game. The first
# login may ask for a Steam Guard code, so run that update interactively once
# (see README) - the session is then kept in the steam volume.
STEAM_USERNAME=your_steam_account
#STEAM_PASSWORD=yourpassword

# Space separated list of Steam apps to install into /arma2.
#   33935  Arma 2: Operation Arrowhead dedicated server
#   33905  Arma 2 dedicated server
#   33930  Arma 2: Operation Arrowhead game data
#   33910  Arma 2 game data (33900 for the other store package)
# DayZ and DayZ Epoch need Combined Operations data:
#   STEAM_APPS=33935 33930 33910
STEAM_APPS=33935
UPDATE_ON_START=1
STEAM_VALIDATE=1

# --- Server -------------------------------------------------------------------
# Profile name (-name); profiles are written to /arma2/<config dir>/<SERVER_NAME>
SERVER_NAME=server
PORT=2302
# Semicolon separated mod folders inside /arma2, e.g. "@DayZ_Epoch;@DayZ_Epoch_Server"
# Left empty for a mod profile it is filled in from MOD_PROFILE.
MODS=
#WORLD=empty
#CPUCCOUNT=2
#EXTHREADS=7
#EXTRA_ARGS=-maxMem=2047

# --- Mods ---------------------------------------------------------------------
# none  : plain Arma 2 / Operation Arrowhead server
# dayz  : DayZ mod (@DayZ + @hive + cfgdayz)
# epoch : DayZ Epoch 1.0.7.1 (@DayZ_Epoch + @DayZ_Epoch_Server + DZE_Server_Config)
MOD_PROFILE=none
# Extra packs to install regardless of the profile (space separated): dayz epoch
#INSTALL_MODS=
# 1 = unpack the packs again over the existing files
#MOD_REINSTALL=0

# DayZ server pack archive: .7z/.zip/.rar URL or Google Drive link/file id, or an
# archive dropped into ./mods. Vanilla DayZ has no live official download, so this
# has to point at a pack you trust (required for MOD_PROFILE=dayz).
#DAYZ_SERVER_URL=
#DAYZ_ARCHIVE_PASSWORD=

# Epoch server pack. Default: official DayZ Epoch 1.0.7.1 server release
# (Google Drive, password 123456).
#EPOCH_SERVER_URL=
#EPOCH_ARCHIVE_PASSWORD=123456

# --- Hive database ------------------------------------------------------------
# Both mods store player/world state in MySQL through HiveExt.dll. These values
# are pushed into the packs' HiveExt.ini; the mariadb service in docker-compose.yml
# uses the same ones.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=dayz_epoch
DB_USER=dayz
DB_PASSWORD=dayz
DB_ROOT_PASSWORD=dayzroot

# --- BattlEye ----------------------------------------------------------------
# RCon password written into the pack's BEServer.cfg on every start.
#BE_RCON_PASSWORD=changeme
# Filter folder (-BEpath); defaults to <config dir>/BattlEye when the pack has one.
#BE_PATH=

# --- Generated server.cfg (only used on first start, MOD_PROFILE=none) ---------
SERVER_HOSTNAME=Arma 2 Dedicated Server
MAX_PLAYERS=32
SERVER_PASSWORD=
ADMIN_PASSWORD=changeme
BATTLEYE=1
STEAM_PORT=8766
STEAM_QUERY_PORT=27016
# "|" separates MOTD lines
MOTD=Welcome to the server|Be nice, read the rules
#MISSION=coop_01.Chernarus
