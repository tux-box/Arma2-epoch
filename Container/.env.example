# Copy to .env and fill in. The account must own Arma 2 and Arma 2 Operation Arrowhead.
STEAM_USERNAME=
STEAM_PASSWORD=
# Both can stay blank once ./arma/arma2oaserver.exe exists: the download is then skipped.

# Server launch options (see docker/entrypoint.sh).
PORT=2302
NAME=server

# Config, cfg, profiles and mods are optional and stay empty for a plain server.
# For a DayZ Epoch Takistan server with the Epoch server files in ./arma, for example:
#   CONFIG=DZE_Server_Config/basic.cfg
#   CFG=DZE_Server_Config/1_takistan.cfg
#   PROFILES=DZE_Server_Config
#   MODS=@DayZ_Epoch;@DayZ_Epoch_Server;
CONFIG=
CFG=
PROFILES=
MODS=
